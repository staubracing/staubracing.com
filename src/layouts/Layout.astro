---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/theme.css';
import '../styles/global.css';

const SITE_URL = 'https://staubracing.com';
const DEFAULT_OG_IMAGE = '/images/brand/logo.png';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;  // Relative path like /images/blog/...
  ogType?: 'website' | 'article';
}

const {
  title,
  description = "Motorcycle racing, coding projects, DIY builds, and life updates.",
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website'
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Always use absolute URLs for og:image (required by X/Twitter, Facebook, etc.)
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `${SITE_URL}${ogImage}`;

const absoluteUrl = `${SITE_URL}${currentPath}`;

// Helper to check if a path belongs to a section (includes orphan sub-nav pages)
function isInSection(path: string, section: string): boolean {
  // Direct path match
  if (path.startsWith(`/${section}`)) return true;

  // Orphan pages that belong to sections but have non-nested URLs
  const sectionOrphans: Record<string, string[]> = {
    racing: ['/calendar', '/maintenance'],
    // Add more sections here if needed
  };

  return sectionOrphans[section]?.includes(path) ?? false;
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-L0LK4TPKRM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-L0LK4TPKRM');
    </script>

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-profile-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-profile-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Social -->
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={absoluteUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@StaubRacing106" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="background" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-primary">Staub</span>
        <span class="brand-secondary">Racing</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
        <a href="/racing" class={isInSection(currentPath, 'racing') ? 'active' : ''}>Racing</a>
        <a href="/code" class={isInSection(currentPath, 'code') ? 'active' : ''}>Code</a>
        <a href="/journal" class={isInSection(currentPath, 'journal') ? 'active' : ''}>Journal</a>
        <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a>
        <a href="/resume" class={currentPath === '/resume' ? 'active' : ''}>Resume</a>
      </nav>
    </header>

    <slot name="subnav" />

    <main class="page-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <span class="footer-brand">© {new Date().getFullYear()} <span class="brand-accent">Staub</span>Racing</span>
      <span class="footer-tagline">No bullshit. Just bikes, builds, and bytes.</span>
      <ThemeToggle />
    </footer>

    <script is:inline>
      // Theme initialization - runs immediately to prevent flash
      // Supports: 'light', 'dark', or 'system' preference
      (function() {
        function getSystemTheme() {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        function getEffectiveTheme(preference) {
          if (preference === 'system' || !preference) {
            return getSystemTheme();
          }
          return preference;
        }

        function setTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }

        function savePreference(preference) {
          localStorage.setItem('theme-preference', preference);
        }

        function getStoredPreference() {
          return localStorage.getItem('theme-preference') || 'system';
        }

        // Initialize immediately
        const preference = getStoredPreference();
        const effectiveTheme = getEffectiveTheme(preference);
        setTheme(effectiveTheme);

        // Listen for preference changes from toggle
        document.addEventListener('theme-preference-change', (e) => {
          const newPreference = e.detail.preference;
          savePreference(newPreference);
          setTheme(getEffectiveTheme(newPreference));

          // Notify toggle component
          document.dispatchEvent(new CustomEvent('theme-preference-changed', {
            detail: { preference: newPreference }
          }));
        });

        // Listen for system preference changes (only if user has 'system' selected)
        window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
          const currentPreference = getStoredPreference();
          if (currentPreference === 'system') {
            setTheme(getSystemTheme());
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  /* ============================================
     LAYOUT-SPECIFIC STYLES
     Global styles are in src/styles/global.css
     Theme variables are in src/styles/theme.css
     ============================================ */

  .background {
    position: fixed;
    inset: 0;
    background:
      var(--bg-highlight-1),
      var(--bg-highlight-2),
      var(--bg-overlay);
    z-index: -2;
  }

  .site-header {
    position: sticky;
    top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--layout-max);
    margin: 1.25rem auto;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    border: 1px solid var(--surface-border);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-soft);
    z-index: 5;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    font-family: var(--brand-font);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 1.15rem;
    font-weight: 700;
    transition: opacity 0.2s ease;
  }

  .brand:hover {
    opacity: 0.85;
  }

  .brand-primary {
    color: var(--accent-lime);
    font-weight: 800;
  }

  .brand-secondary {
    color: var(--text-primary);
    font-weight: 700;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .site-nav a {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--text-primary);
  }

  .site-nav a.active {
    color: var(--accent-lime);
    font-weight: 600;
  }

  .site-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-lime);
    border-radius: 1px;
  }

  .page-shell {
    position: relative;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 2rem 0 6rem;
    display: grid;
    gap: 2rem;
  }

  .site-footer {
    max-width: var(--layout-max);
    margin: 0 auto 2.5rem;
    padding: 1rem 1.5rem;
    border-top: 2px solid var(--accent-racing);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .footer-brand {
    font-weight: 600;
  }

  .footer-brand .brand-accent {
    color: var(--accent-lime);
  }

  .footer-tagline {
    font-style: italic;
    opacity: 0.8;
  }

  @media (max-width: 480px) {
    .site-footer {
      flex-direction: column;
      text-align: center;
      gap: 0.75rem;
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {

    .site-header {
      flex-direction: column;
      align-items: flex-start;
      position: static;
      margin-top: 1.5rem;
    }

    .site-nav {
      width: 100%;
      justify-content: flex-start;
    }

    .page-shell {
      padding-top: 1rem;
      gap: 1.5rem;
    }
  }
</style>
