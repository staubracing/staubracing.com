---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';
---

<Layout title="Contact - StaubRacing">
  <section class="section-card">
    <header class="section-header">
      <h1>Contact</h1>
      <p>Want to talk bikes, code, or just say hi? Find me here.</p>
    </header>

    <SocialIcons variant="contact" />

    <p class="contact-note">
      <strong>Business inquiries:</strong> LinkedIn is best.<br />
      <strong>Racing updates:</strong> Follow along on X.
    </p>
  </section>
</Layout>

<style>
  .section-card {
    border: none;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .contact-note {
    margin: 0;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--surface-border);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-note strong {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
