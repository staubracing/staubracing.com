---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';
---

<Layout title="Contact - StaubRacing">
  <section class="section-card">
    <header class="section-header">
      <h1>Contact</h1>
      <p>Want to talk bikes, code, or just say hi? Find me here.</p>
    </header>

    <SocialIcons variant="contact" />

    <div class="resume-row">
      <a href="/resume" class="resume-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        Resume
      </a>
    </div>

    <p class="contact-note">
      <strong>Business inquiries:</strong> LinkedIn is best.<br />
      <strong>Racing updates:</strong> Follow along on X.
    </p>
  </section>
</Layout>

<style>
  .section-card {
    border: none;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  /* ── Resume pill ── */
  .resume-row {
    display: flex;
    justify-content: center;
  }

  .resume-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.75rem 2rem;
    width: min(360px, 100%);
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    background: var(--surface-soft);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .resume-pill svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .resume-pill:hover,
  .resume-pill:focus-visible {
    border-color: var(--accent-lime);
    background: var(--surface-solid);
    color: var(--text-primary);
    transform: translateY(-1px);
    box-shadow: 0 0 18px -4px color-mix(in srgb, var(--accent-lime) 40%, transparent);
  }

  .resume-pill:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg-base), 0 0 0 4px var(--accent-lime);
  }

  .resume-pill:active {
    transform: translateY(0);
  }

  /* ── Contact note ── */
  .contact-note {
    margin: 0;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--surface-border);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-note strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-pill,
    .pill-arrow {
      transition: none;
    }

    .resume-pill:hover,
    .resume-pill:focus-visible {
      transform: none;
    }
  }
</style>
