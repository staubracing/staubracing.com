---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Login - StaubRacing">
  <section class="section-card">
    <header class="section-header">
      <h1>Login</h1>
      <p>Sign in with your StaubRacing account.</p>
    </header>

    <form id="login-form" class="login-form">
      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Enter your username"
          required
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          required
          autocomplete="current-password"
        />
      </div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <span class="btn-text">Sign In</span>
        <span class="btn-arrow">→</span>
      </button>

      <p id="error-msg" class="error-msg"></p>
    </form>
  </section>
</Layout>

<script>
  import { configureAuth, signIn, isAuthenticated } from '../../services/auth';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Initialize Cognito
  configureAuth();

  // Check if already logged in
  async function checkAuth() {
    const authenticated = await isAuthenticated();
    if (authenticated) {
      window.location.href = '/admin/maintenance';
    }
  }

  // Run auth check on page load
  checkAuth();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const username = (document.getElementById('username') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    if (!username || !password) {
      errorMsg.textContent = 'Please enter both username and password';
      return;
    }

    // Disable button during sign-in
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="btn-text">Signing in...</span>';
    errorMsg.textContent = '';

    try {
      await signIn(username, password);
      window.location.href = '/admin/maintenance';
    } catch (err: any) {
      // Handle Cognito errors
      const message = err?.message || 'Sign in failed. Please try again.';

      // Map common Cognito error codes to friendly messages
      if (err?.code === 'NotAuthorizedException') {
        errorMsg.textContent = 'Incorrect username or password';
      } else if (err?.code === 'UserNotFoundException') {
        errorMsg.textContent = 'User not found';
      } else if (err?.code === 'UserNotConfirmedException') {
        errorMsg.textContent = 'Please verify your email first';
      } else {
        errorMsg.textContent = message;
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span class="btn-text">Sign In</span><span class="btn-arrow">→</span>';
    }
  });
</script>

<style>
  .section-card {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.75rem, 2.5vw, 2.75rem);
    background: var(--surface-solid);
    border-radius: var(--radius-lg);
    border: 1px solid var(--surface-border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
    max-width: 480px;
    margin: 0 auto;
  }

  .section-header {
    display: grid;
    gap: 0.8rem;
    text-align: center;
  }

  .section-header h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .section-header p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .login-form {
    display: grid;
    gap: 1.25rem;
  }

  .form-group {
    display: grid;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .form-group input {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-border);
    background: var(--overlay-base-light);
    color: var(--text-primary);
    font-size: 1rem;
    transition: border 0.2s ease, background 0.2s ease;
  }

  .form-group input::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent-electric);
    background: var(--overlay-accent-light);
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md);
    border: none;
    background: var(--accent-racing);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hard);
  }

  .submit-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .submit-btn:hover:not(:disabled) .btn-arrow {
    transform: translateX(4px);
  }

  .error-msg {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: var(--overlay-warning-light);
    border: 1px solid var(--accent-amber);
    color: var(--accent-amber);
    font-size: 0.9rem;
    text-align: center;
    display: none;
  }

  .error-msg:not(:empty) {
    display: block;
  }
</style>
