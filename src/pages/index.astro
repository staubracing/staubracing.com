---
import Layout from '../layouts/Layout.astro';
---

<Layout title="StaubRacing - Racing, Code & Everything Between">
  <section class="hero" id="top">
    <div class="hero-portrait">
      <img
        src="/images/StaubRacing-Profile-green.png"
        alt="Chris Staub - Engineer, Racer, Developer"
        class="portrait-image"
        width="180"
        height="180"
        loading="eager"
      />
      <div class="portrait-glow" aria-hidden="true"></div>
    </div>
    <div class="hero-content">
      <span class="hero-eyebrow pill">Engineer · Racer · Developer</span>
      <div class="hero-brand">
        <h1>Welcome to <span class="brand-accent">Staub</span>Racing!</h1>
      </div>
      <p class="hero-subtitle">
        I race motorcycles with more heart than skill, write code with more determination than genius, and document the whole beautiful disaster here.
      </p>
      <div class="hero-badge">
        <span class="badge-item">EST 2020</span>
        <span class="badge-divider">·</span>
        <span class="badge-item">CRA #106</span>
      </div>
    </div>
  </section>

  <section class="section-card about-section">
    <h2>About</h2>
    <p class="lead">Hey, I'm Chris.</p>
    <p>
      I spent my early twenties on the ramp at MSP, keeping tired 727s flying through Minnesota winters on midnight shifts. That's where I learned that everything is fixable if you're stubborn enough and willing to work in the cold.
    </p>
    <p>
      Now I'm a manufacturing engineer in the medical device world — FDA regulations, validation protocols, and the kind of precision that doesn't leave room for "close enough." By night, I write code. React Native apps, AWS infrastructure, homelab experiments, websites (you're looking at one), and whatever else I can't stop tinkering with.
    </p>
    <p>
      On weekends, I race motorcycles. Central Road Racing here in Minnesota, number 106, Ultralight and Middleweight classes, five years in. A 2014 KX450F for supermoto and a 2009 ZX6R that I've rebuilt more times than I'll admit.
    </p>
    <p>Same approach to all of it: take it apart, figure out how it works, make it better.</p>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(2.5rem, 8vw, 4rem) clamp(1.5rem, 5vw, 3.5rem);
    margin-top: 2rem;
    background: transparent;
    border-radius: var(--radius-lg);
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    position: relative;
    overflow: hidden;
  }

  .hero-portrait {
    position: relative;
    flex-shrink: 0;
  }

  .portrait-image {
    width: clamp(120px, 18vw, 180px);
    height: clamp(120px, 18vw, 180px);
    border-radius: 50%;
    object-fit: cover;
    position: relative;
    z-index: 2;
    animation: portrait-float 6s ease-in-out infinite;
  }

  .portrait-glow {
    position: absolute;
    inset: -15%;
    background: radial-gradient(circle at center, rgba(102, 187, 106, 0.25) 0%, transparent 60%);
    z-index: 1;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  @keyframes portrait-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  .hero-content {
    display: grid;
    gap: 1rem;
    text-align: left;
  }

  .hero-eyebrow {
    justify-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    font-family: var(--brand-font);
    letter-spacing: 0.08em;
    margin: 0;
  }

  .brand-accent {
    color: var(--accent-lime);
    text-shadow: 0 0 30px rgba(102, 187, 106, 0.4);
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 0 20px rgba(102, 187, 106, 0.25);
  }

  .badge-divider {
    color: var(--accent-lime);
  }

  .hero-subtitle {
    max-width: 520px;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  .about-section {
    border: none;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .about-section h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .about-section .lead {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .about-section p {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
  }

  .about-section p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2rem 1.5rem;
      gap: 1.75rem;
    }

    .hero-portrait {
      justify-self: center;
    }

    .hero-content {
      text-align: center;
      gap: 1rem;
    }

    .hero-eyebrow {
      justify-self: center;
    }

    .hero-subtitle {
      max-width: 100%;
    }

    .hero-badge {
      justify-content: center;
    }
  }
</style>
